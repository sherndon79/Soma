{
  "schema_version": 1,
  "default_profile": "gemma4-local",
  "profiles": [
    {
      "id": "gemma4-local",
      "name": "Gemma 4 Local",
      "route": "local",
      "runtime": "openai-compatible-http",
      "endpoint": "http://127.0.0.1:8000",
      "model": "ciocan/gemma-4-E4B-it-W4A16",
      "max_context_tokens": 4096,
      "tool_calls_supported": true,
      "tool_calls_enabled": false,
      "remote_service": false,
      "allowed_data_classes": ["submitted_text"],
      "description": "Local Gemma 4 model served by vLLM through an OpenAI-compatible API."
    },
    {
      "id": "claude-remote",
      "name": "Claude Remote",
      "route": "remote",
      "runtime": "anthropic-messages",
      "endpoint": "https://api.anthropic.com",
      "model": "claude-sonnet-4-20250514",
      "max_context_tokens": 200000,
      "tool_calls_supported": false,
      "tool_calls_enabled": false,
      "remote_service": true,
      "allowed_data_classes": ["submitted_text"],
      "description": "Remote Anthropic Messages API profile for first-breath harness evaluation. Requires an explicit model.remote.chat grant and ANTHROPIC_API_KEY."
    }
  ]
}
