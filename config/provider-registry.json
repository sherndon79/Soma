{
  "schema_version": 1,
  "providers": [
    {
      "id": "soma.provider.local-model",
      "name": "Local Model Runtime",
      "version": "0.1.0",
      "runtime": "openai-compatible-http",
      "local_only": true,
      "network_access": false,
      "capabilities": [
        {
          "key": "model.local.chat",
          "provider_contract": "soma.model.chat.v1",
          "output_schema": "soma.model.chat.response.v1"
        },
        {
          "key": "model.local.tool_calls",
          "provider_contract": "soma.model.tool_calls.v1",
          "output_schema": "soma.model.tool_calls.response.v1"
        },
        {
          "key": "model.context.visual.color.attach",
          "provider_contract": "soma.model.context.visual.color.attach.v1",
          "output_schema": "soma.model.context.visual.attach.proposal.v1"
        },
        {
          "key": "model.context.visual.depth.attach",
          "provider_contract": "soma.model.context.visual.depth.attach.v1",
          "output_schema": "soma.model.context.visual.attach.proposal.v1"
        },
        {
          "key": "model.context.visual.composite.attach",
          "provider_contract": "soma.model.context.visual.composite.attach.v1",
          "output_schema": "soma.model.context.visual.attach.proposal.v1"
        }
      ]
    },
    {
      "id": "soma.provider.session-memory",
      "name": "In-Process Session Memory",
      "version": "0.1.0",
      "runtime": "node-in-process",
      "local_only": true,
      "network_access": false,
      "capabilities": [
        {
          "key": "memory.session.read",
          "provider_contract": "soma.memory.session.v1",
          "output_schema": "soma.memory.session.read.response.v1"
        },
        {
          "key": "memory.session.write",
          "provider_contract": "soma.memory.session.v1",
          "output_schema": "soma.memory.session.write.response.v1"
        },
        {
          "key": "memory.durable.write",
          "provider_contract": "soma.memory.durable.v1",
          "output_schema": "soma.memory.durable.write.response.v1"
        }
      ]
    },
    {
      "id": "soma.provider.occupant-memory",
      "name": "Occupant Durable Memory Store",
      "version": "0.1.0",
      "runtime": "node-file-backed",
      "local_only": true,
      "network_access": false,
      "capabilities": [
        {
          "key": "occupant.memory.read",
          "provider_contract": "soma.occupant.memory.read.v1",
          "output_schema": "soma.occupant.memory.read.response.v1"
        },
        {
          "key": "occupant.memory.write",
          "provider_contract": "soma.occupant.memory.write.v1",
          "output_schema": "soma.occupant.memory.write.response.v1"
        }
      ]
    },
    {
      "id": "soma.provider.anthropic",
      "name": "Anthropic Messages API",
      "version": "0.1.0",
      "runtime": "anthropic-messages",
      "local_only": false,
      "network_access": true,
      "capabilities": [
        {
          "key": "model.remote.chat",
          "provider_contract": "soma.model.chat.v1",
          "output_schema": "soma.model.chat.response.v1"
        }
      ]
    },
    {
      "id": "soma.provider.provenance-log",
      "name": "In-Process Provenance Log",
      "version": "0.1.0",
      "runtime": "node-in-process",
      "local_only": true,
      "network_access": false,
      "capabilities": [
        {
          "key": "provenance.read",
          "provider_contract": "soma.provenance.v1",
          "output_schema": "soma.provenance.read.response.v1"
        },
        {
          "key": "provenance.clear",
          "provider_contract": "soma.provenance.v1",
          "output_schema": "soma.provenance.clear.response.v1"
        }
      ]
    },
    {
      "id": "soma.provider.provenance-summary",
      "name": "Curated Provenance Summary",
      "version": "0.1.0",
      "runtime": "node-in-process",
      "local_only": true,
      "network_access": false,
      "capabilities": [
        {
          "key": "provenance.summary.read",
          "provider_contract": "soma.provenance.summary.read.v1",
          "output_schema": "soma.provenance.summary.read.response.v1"
        }
      ]
    },
    {
      "id": "soma.provider.stewardship",
      "name": "Text Stewardship Assessments",
      "version": "0.1.0",
      "runtime": "node-in-process",
      "local_only": true,
      "network_access": false,
      "capabilities": [
        {
          "key": "stewardship.cognitive_load.assess",
          "provider_contract": "soma.stewardship.cognitive_load.v1",
          "output_schema": "soma.stewardship.cognitive_load.response.v1"
        }
      ]
    },
    {
      "id": "soma.provider.synthetic-systemd",
      "name": "Synthetic Systemd Service Provider",
      "version": "0.1.0",
      "runtime": "node-in-process",
      "local_only": true,
      "network_access": false,
      "testing_only": true,
      "capabilities": [
        {
          "key": "host.service.status.read",
          "provider_contract": "soma.host.service.status.read.v1",
          "output_schema": "soma.host.service.status.read.response.v1"
        },
        {
          "key": "host.service.restart",
          "provider_contract": "soma.host.service.restart.apply.v1",
          "output_schema": "soma.host.service.restart.outcome.v1"
        }
      ]
    },
    {
      "id": "soma.provider.systemd-local",
      "name": "Local Systemd Service Provider",
      "version": "0.1.0",
      "runtime": "native-binary",
      "binary": "./target/debug/soma-systemd-provider",
      "local_only": true,
      "network_access": false,
      "activation_status": "disabled",
      "capabilities": [
        {
          "key": "host.service.status.read",
          "provider_contract": "soma.host.service.status.read.v1",
          "output_schema": "soma.host.service.status.read.response.v1"
        },
        {
          "key": "host.service.restart",
          "provider_contract": "soma.host.service.restart.apply.v1",
          "output_schema": "soma.host.service.restart.outcome.v1"
        }
      ]
    },
    {
      "id": "soma.provider.status",
      "name": "In-Process Status Snapshot",
      "version": "0.1.0",
      "runtime": "node-in-process",
      "local_only": true,
      "network_access": false,
      "capabilities": [
        {
          "key": "status.snapshot.read",
          "provider_contract": "soma.status.snapshot.v1",
          "output_schema": "soma.status.snapshot.response.v1"
        },
        {
          "key": "space.status.read",
          "provider_contract": "soma.space.status.read.v1",
          "output_schema": "soma.space.status.read.result.v1"
        }
      ]
    },
    {
      "id": "soma.provider.history-projection",
      "name": "In-Process History Projection",
      "version": "0.1.0",
      "runtime": "node-in-process",
      "local_only": true,
      "network_access": false,
      "capabilities": [
        {
          "key": "space.history.read",
          "provider_contract": "soma.space.history.read.v1",
          "output_schema": "soma.space.history.read.result.v1"
        }
      ]
    },
    {
      "id": "soma.provider.scoped-files",
      "name": "Scoped File Reader",
      "version": "0.1.0",
      "runtime": "node-in-process",
      "local_only": true,
      "network_access": false,
      "capabilities": [
        {
          "key": "tool.files.read",
          "provider_contract": "soma.files.read.v1",
          "output_schema": "soma.files.read.response.v1"
        }
      ]
    },
    {
      "id": "soma.provider.desktop-broker",
      "name": "Soma Desktop Broker",
      "version": "0.1.0",
      "runtime": "native-binary",
      "binary": "./target/debug/soma-desktop-broker",
      "local_only": true,
      "network_access": false,
      "requires": ["at-spi2-core", "dbus-session"],
      "capabilities": [
        {
          "key": "desktop.inspect.accessibility_tree",
          "provider_contract": "soma.desktop.inspect.accessibility_tree.v1",
          "output_schema": "docs/schemas/desktop-inspection-result.schema.json",
          "command": "inspect-atspi"
        },
        {
          "key": "desktop.inspect.focus",
          "provider_contract": "soma.desktop.inspect.focus.v1",
          "output_schema": "soma.desktop.inspect.focus.response.v1",
          "command": "inspect-focus",
          "operator_note": "Intentionally remains on the native desktop broker provider. Focus is a bounded broker probe and exact capability+provider grants already exist for this key; synthetic-container text/windows/actuation grants are separate policy identifiers."
        },
        {
          "key": "desktop.inspect.windows",
          "provider_contract": "soma.desktop.inspect.windows.v1",
          "output_schema": "soma.desktop.inspect.windows.response.v1",
          "command": "inspect-windows"
        }
      ]
    },
    {
      "id": "soma.provider.synthetic-desktop",
      "name": "Synthetic Desktop Fixture Provider",
      "version": "0.1.0",
      "runtime": "node-in-process",
      "local_only": true,
      "network_access": false,
      "capabilities": [
        {
          "key": "desktop.inspect.accessibility_tree",
          "provider_contract": "soma.desktop.inspect.accessibility_tree.v1",
          "output_schema": "docs/schemas/desktop-inspection-result.schema.json",
          "provider_mode": "synthetic_fixture"
        }
      ]
    },
    {
      "id": "soma.provider.synthetic-container-desktop",
      "name": "Synthetic Container Desktop Provider",
      "version": "0.1.0",
      "runtime": "docker-compose-exec",
      "local_only": true,
      "network_access": false,
      "capabilities": [
        {
          "key": "desktop.inspect.accessibility_tree",
          "provider_contract": "soma.desktop.inspect.accessibility_tree.v1",
          "output_schema": "docs/schemas/desktop-inspection-result.schema.json",
          "provider_mode": "synthetic_container_live"
        },
        {
          "key": "desktop.inspect.windows",
          "provider_contract": "soma.desktop.inspect.windows.v1",
          "output_schema": "soma.desktop.inspect.windows.response.v1",
          "provider_mode": "synthetic_container_live"
        },
        {
          "key": "desktop.inspect.text",
          "provider_contract": "soma.desktop.inspect.text.v1",
          "output_schema": "soma.desktop.inspect.text.response.v1",
          "provider_mode": "synthetic_container_live"
        },
        {
          "key": "desktop.act.invoke_action",
          "provider_contract": "soma.desktop.act.invoke_action.v1",
          "output_schema": "soma.desktop.act.response.v1",
          "provider_mode": "synthetic_container_live"
        },
        {
          "key": "desktop.act.text_input",
          "provider_contract": "soma.desktop.act.text_input.v1",
          "output_schema": "soma.desktop.act.response.v1",
          "provider_mode": "synthetic_container_live"
        }
      ]
    },
    {
      "id": "soma.provider.sensorium.jetsorano",
      "name": "Sensorium Node (jetsorano)",
      "version": "0.1.0",
      "runtime": "zenoh-subscriber",
      "local_only": false,
      "network_access": true,
      "network_scope": "lan-zenoh-peer",
      "host_segment": "jetsorano",
      "requires": [
        "soma-sensor-broker",
        "zenoh client transport"
      ],
      "capabilities": [
        {
          "key": "perception.sensorium.color.subscribe",
          "provider_contract": "soma.perception.sensorium.color.v1",
          "output_schema": "soma.perception.sensorium.color.response.v1"
        },
        {
          "key": "perception.sensorium.depth.subscribe",
          "provider_contract": "soma.perception.sensorium.depth.v1",
          "output_schema": "soma.perception.sensorium.depth.response.v1"
        },
        {
          "key": "perception.sensorium.imu.subscribe",
          "provider_contract": "soma.perception.sensorium.imu.v1",
          "output_schema": "soma.perception.sensorium.imu.response.v1"
        },
        {
          "key": "perception.sensorium.location.subscribe",
          "provider_contract": "soma.perception.sensorium.location.v1",
          "output_schema": "soma.perception.sensorium.location.response.v1"
        },
        {
          "key": "perception.sensorium.status.subscribe",
          "provider_contract": "soma.perception.sensorium.status.v1",
          "output_schema": "soma.perception.sensorium.status.response.v1"
        }
      ]
    },
    {
      "id": "soma.provider.sensorium-tier",
      "name": "Local Sensorium Tier",
      "version": "0.1.0",
      "runtime": "node-in-process",
      "local_only": true,
      "network_access": false,
      "capabilities": [
        {
          "key": "sensorium.semantic_events.read",
          "provider_contract": "soma.sensorium.semantic_events.read.v1",
          "output_schema": "soma.sensorium.semantic_event.v1"
        },
        {
          "key": "desktop.visual_cue.present",
          "provider_contract": "soma.desktop.visual_cue.present.v1",
          "output_schema": "soma.desktop.visual_cue.present.response.v1"
        }
      ]
    },
    {
      "id": "soma.provider.remote_desktop.sunshine",
      "name": "Remote Desktop Sunshine/Moonlight Transport",
      "version": "0.1.0",
      "runtime": "remote-graphical-session",
      "local_only": false,
      "network_access": true,
      "network_scope": "lan-sunshine-moonlight",
      "requires": [
        "Sunshine host pairing",
        "Moonlight-compatible client broker",
        "operator-visible session disclosure"
      ],
      "capabilities": [
        {
          "key": "perception.remote_desktop.video.subscribe",
          "provider_contract": "soma.perception.remote_desktop.video.v1",
          "output_schema": "soma.perception.remote_desktop.video.response.v1"
        },
        {
          "key": "desktop.remote.input.pointer",
          "provider_contract": "soma.desktop.remote.input.pointer.v1",
          "output_schema": "soma.desktop.remote.input.pointer.response.v1"
        },
        {
          "key": "desktop.remote.input.keyboard",
          "provider_contract": "soma.desktop.remote.input.keyboard.v1",
          "output_schema": "soma.desktop.remote.input.keyboard.response.v1"
        },
        {
          "key": "desktop.remote.session.disconnect",
          "provider_contract": "soma.desktop.remote.session.disconnect.v1",
          "output_schema": "soma.desktop.remote.session.disconnect.response.v1"
        }
      ]
    }
  ]
}
