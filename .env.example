# Soma service
SOMA_PORT=8765
# SOMA_QUEST_SURFACE_REAL_ANSWER=0 # Set to 1/true/yes/on to use real Whisper->Gemma->Kokoro stages; when off the fixture path is byte-identical
SOMA_LLM_URL=http://127.0.0.1:8000
SOMA_LLM_MODEL=ciocan/gemma-4-E4B-it-W4A16
# Local inference (I-2) — config-driven endpoints, fail-closed if down
# Host defaults (curl :4001/health :4010/health :8000/health); for docker-network use whisper-stt:4001 etc
SOMA_WHISPER_URL=http://127.0.0.1:4001
SOMA_KOKORO_URL=http://127.0.0.1:4010
SOMA_TOOL_CALL_TEMPERATURE=0.2
# Sensorium stays off unless explicitly enabled by the operator.
SOMA_SENSORIUM_ENABLED=0
# SOMA_SENSOR_BROKER=/home/sherndon/project-repos/Soma/target/debug/soma-sensor-broker
# SOMA_SENSORIUM_ZENOH_CONFIG=/home/sherndon/project-repos/Soma/config/sensorium-zenoh-client.example.json5

# Local vLLM compose
LLM_PORT=8000
LLM_MODEL=ciocan/gemma-4-E4B-it-W4A16
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEMORY_UTILIZATION=0.50
VLLM_MAX_CONCURRENCY=4
VLLM_TOOL_CALL_PARSER=gemma4
LLM_CUDA_VISIBLE_DEVICES=0
# HF_TOKEN=
