#!/usr/bin/env bash
set -euo pipefail

export DISPLAY="${DISPLAY:-:99}"
export NO_AT_BRIDGE=0
export GTK_MODULES="${GTK_MODULES:-gail:atk-bridge}"
export QT_ACCESSIBILITY=1
export QT_LINUX_ACCESSIBILITY_ALWAYS_ON=1
export CANARY_MANIFEST="${CANARY_MANIFEST:-/opt/soma/desktop-realism/canary-manifest.json}"
export NOVNC_PORT="${NOVNC_PORT:-6080}"
export VNC_PORT="${VNC_PORT:-5900}"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-GNOME-Flashback:GNOME}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-gnome-flashback-metacity}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-x11}"
export LANG="${LANG:-C.UTF-8}"
export LC_ALL="${LC_ALL:-C.UTF-8}"
export LIBGL_ALWAYS_SOFTWARE=1
export GDK_BACKEND=x11
export QT_QPA_PLATFORM=xcb

printf '%s\n' "$DBUS_SESSION_BUS_ADDRESS" > /tmp/soma-session-bus-address

cleanup() {
  jobs -pr | xargs -r kill 2>/dev/null || true
}
trap cleanup EXIT INT TERM

Xvfb "$DISPLAY" -screen 0 "${XVFB_GEOMETRY:-1440x900x24}" -nolisten tcp +extension GLX +render &

for _ in $(seq 1 100); do
  if xdpyinfo -display "$DISPLAY" >/dev/null 2>&1; then
    break
  fi
  sleep 0.25
done
xdpyinfo -display "$DISPLAY" >/dev/null

mkdir -p "$HOME/Desktop" "$HOME/Documents" "$HOME/Downloads"

if command -v gsettings >/dev/null 2>&1; then
  gsettings set org.gnome.desktop.interface toolkit-accessibility true >/tmp/soma-gsettings.log 2>&1 || true
fi

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment \
    DISPLAY \
    GDK_BACKEND \
    GTK_MODULES \
    LANG \
    LC_ALL \
    NO_AT_BRIDGE \
    QT_ACCESSIBILITY \
    QT_LINUX_ACCESSIBILITY_ALWAYS_ON \
    QT_QPA_PLATFORM \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_DESKTOP \
    XDG_SESSION_TYPE \
    >/tmp/soma-dbus-activation-env.log 2>&1 || true
fi

if command -v at-spi2-registryd >/dev/null 2>&1; then
  at-spi2-registryd >/tmp/soma-atspi-registry.log 2>&1 &
elif [ -x /usr/lib/at-spi2-core/at-spi2-registryd ]; then
  /usr/lib/at-spi2-core/at-spi2-registryd >/tmp/soma-atspi-registry.log 2>&1 &
fi

{
  printf 'Starting GNOME Flashback components directly for the containerized X11 mirror.\n'
  printf 'gnome-session is intentionally avoided because it requires a fuller systemd/system-bus login session.\n'
} > /tmp/soma-gnome-session.log

metacity >/tmp/soma-metacity.log 2>&1 &

if command -v gnome-flashback >/dev/null 2>&1; then
  gnome-flashback >>/tmp/soma-gnome-session.log 2>&1 &
fi

if command -v gnome-panel >/dev/null 2>&1; then
  gnome-panel >>/tmp/soma-gnome-session.log 2>&1 &
fi

for _ in $(seq 1 60); do
  if pgrep -x metacity >/dev/null 2>&1 || pgrep -x gnome-flashback >/dev/null 2>&1 || pgrep -x gnome-panel >/dev/null 2>&1; then
    break
  fi
  sleep 0.5
done

python3 /usr/local/bin/desktop-realism-seed-gnome-apps.py >/tmp/soma-seed-gnome-apps.log 2>&1 &

/usr/local/bin/canary-gtk-app.py >/tmp/soma-canary-gtk.log 2>&1 &
/usr/local/bin/canary-qt-app.py >/tmp/soma-canary-qt.log 2>&1 &

x11vnc \
  -display "$DISPLAY" \
  -forever \
  -shared \
  -viewonly \
  -nopw \
  -listen 127.0.0.1 \
  -rfbport "$VNC_PORT" \
  >/tmp/soma-x11vnc.log 2>&1 &

websockify \
  --web /usr/share/novnc \
  "0.0.0.0:${NOVNC_PORT}" \
  "127.0.0.1:${VNC_PORT}" \
  >/tmp/soma-websockify.log 2>&1 &

printf 'Soma Ubuntu GNOME/X11 realism mirror started. noVNC inside container: http://127.0.0.1:%s/vnc.html?autoconnect=1&resize=scale\n' "$NOVNC_PORT"

while true; do
  sleep 3600 &
  wait $!
done
