      "expected_error": "desktop_traversal_request_invalid",
      "body": {
        "mode": "atspi",
        "traversal": {
          "enabled": true,
          "root_ref": "desktop-ref-1",
          "root": {
            "service": ":1.42",
            "path": "/org/a11y/atspi/accessible/root"
          },
          "max_depth": 2,
          "max_nodes": 64,
          "max_children_per_node": 8
        }
      }
    },
    {
