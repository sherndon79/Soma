FROM rust:1-bookworm AS broker-builder

WORKDIR /build

COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/

RUN cargo build --release --locked -p soma-desktop-broker

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    at-spi2-core \
    ca-certificates \
    curl \
    dbus-x11 \
    fonts-dejavu-core \
    gedit \
    gnome-control-center \
    gnome-shell \
    gnome-terminal \
    gnome-text-editor \
    gnupg \
    mutter \
    nautilus \
    novnc \
    python3 \
    python3-gi \
    python3-pyqt5 \
    qtwayland5 \
    systemd \
    websockify \
    x11-utils \
    x11vnc \
    xdg-desktop-portal \
    xdg-desktop-portal-gnome \
    xwayland \
    xvfb \
  && rm -rf /var/lib/apt/lists/*

# Real browser engines for a11y-tree realism: Firefox (Gecko) and Microsoft Edge (Blink).
# Ubuntu 24.04's archive ships snap transitional stubs for both, which cannot run in this
# container, so the vendor apt repositories provide the actual debs. The Edge repo is amd64-only.
RUN install -d -m 0755 /etc/apt/keyrings \
  && curl -fsSL https://packages.mozilla.org/apt/repo-signing-key.gpg \
    -o /etc/apt/keyrings/packages.mozilla.org.asc \
  && printf 'deb [signed-by=/etc/apt/keyrings/packages.mozilla.org.asc] https://packages.mozilla.org/apt mozilla main\n' \
    > /etc/apt/sources.list.d/mozilla.list \
  && printf 'Package: firefox*\nPin: origin packages.mozilla.org\nPin-Priority: 1000\n' \
    > /etc/apt/preferences.d/mozilla-firefox \
  && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
    | gpg --dearmor -o /etc/apt/keyrings/microsoft-edge.gpg \
  && printf 'deb [arch=amd64 signed-by=/etc/apt/keyrings/microsoft-edge.gpg] https://packages.microsoft.com/repos/edge stable main\n' \
    > /etc/apt/sources.list.d/microsoft-edge.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends \
    firefox \
    microsoft-edge-stable \
  && rm -rf /var/lib/apt/lists/*

COPY --from=broker-builder /build/target/release/soma-desktop-broker /usr/local/bin/soma-desktop-broker
COPY docker/desktop-realism/bin/ /usr/local/bin/
COPY docs/fixtures/desktop-realism/canary-manifest-gnome.json /opt/soma/desktop-realism/canary-manifest.json

RUN chmod 0755 \
    /usr/local/bin/canary-gtk-app.py \
    /usr/local/bin/canary-qt-app.py \
    /usr/local/bin/desktop-realism-actuation-preflight.py \
    /usr/local/bin/desktop-realism-atspi-token-probe.py \
    /usr/local/bin/desktop-realism-broker-assert-canaries.py \
    /usr/local/bin/desktop-realism-broker-assert-text-canaries.py \
    /usr/local/bin/desktop-realism-broker-inspect \
    /usr/local/bin/desktop-realism-entrypoint \
    /usr/local/bin/desktop-realism-gnome-session \
    /usr/local/bin/desktop-realism-gnome-healthcheck \
    /usr/local/bin/desktop-realism-isolation-check \
    /usr/local/bin/desktop-realism-seed-gnome-apps.py \
    /usr/local/bin/desktop-realism-session \
    /usr/local/bin/desktop-realism-wayland-healthcheck \
    /usr/local/bin/desktop-realism-wayland-isolation-check \
    /usr/local/bin/desktop-realism-wayland-session

EXPOSE 6080

HEALTHCHECK --interval=10s --timeout=45s --start-period=120s --retries=12 \
  CMD ["/usr/local/bin/desktop-realism-wayland-healthcheck"]

ENTRYPOINT ["/usr/local/bin/desktop-realism-entrypoint"]
