      "reversible": true,
      "activation_policy": "explicit_grant",
      "provider_contract": "soma.space.history.read.v1",
      "description": "Let an occupant invoke a one-shot, curated history projection read. It can return only approved same-domain occupant-audience projection entries and never raw or withheld history."
    },
