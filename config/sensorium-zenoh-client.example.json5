// Example Zenoh client config for Soma consuming a Sensorium publisher
// across a routed subnet where multicast discovery does not cross.
//
// This example points at the current jetsorano fixed listener used for
// repeatable live smoke tests:
//   Zenoh can be reached at: tcp/192.168.20.179:7447
//
// If your Sensorium deployment still uses a dynamic Zenoh listen port,
// replace this endpoint with the advertised value from its startup logs
// or pin the publisher listener before relying on this config.

{
  mode: "peer",

  connect: {
    endpoints: ["tcp/192.168.20.179:7447"],
  },
}
