[Unit]
Description=Soma systemd provider
Requires=soma-systemd-provider.socket
After=dbus.socket
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=soma-systemd-provider
Group=soma-systemd-provider
UMask=0077
ExecStart=/usr/libexec/soma/soma-systemd-provider --socket-activated
Environment=SOMA_SYSTEMD_PROVIDER_INVENTORY=/etc/soma/systemd-provider-inventory.json
EnvironmentFile=/etc/soma/systemd-provider-channel.conf

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @module @raw-io @reboot @swap @keyring
ProcSubset=pid
ProtectProc=invisible
DevicePolicy=closed
RemoveIPC=yes
ReadOnlyPaths=/etc/soma/systemd-provider-inventory.json
ReadOnlyPaths=/run/dbus/system_bus_socket

Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
LimitNOFILE=128
MemoryMax=128M
TasksMax=32

# Deliberately no [Install] section. The socket and route remain disabled after packaging.
