{
  "name": "soma",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "soma": "src/cli.js"
  },
  "scripts": {
    "cli": "node src/cli.js",
    "desktop-broker:build": "cargo build -p soma-desktop-broker",
    "eval:capabilities": "node scripts/eval-capabilities.js",
    "grant-preview:smoke": "node scripts/grant-preview-review-smoke.js",
    "graphical-node:smoke": "node scripts/graphical-node-smoke.js",
    "lca:package-validate": "node scripts/validate-lca-package.mjs",
    "moonlight-broker:build": "cargo build -p soma-moonlight-broker",
    "notification-broker:build": "cargo build -p soma-notification-broker",
    "sensorium:smoke": "node scripts/sensorium-live-smoke.js",
    "systemd-provider:package-validate": "node scripts/validate-systemd-provider-package.mjs",
    "systemd-provider:attended-host": "node scripts/systemd-provider-attended-host.mjs",
    "systemd-provider:controlled-test": "bash scripts/systemd-provider-controlled-test.sh",
    "start": "node src/server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  }
}
