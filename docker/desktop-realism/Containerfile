FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    at-spi2-core \
    ca-certificates \
    curl \
    dbus-x11 \
    fonts-dejavu-core \
    gir1.2-gtk-3.0 \
    libglib2.0-bin \
    novnc \
    openbox \
    python3 \
    python3-gi \
    python3-pyqt5 \
    websockify \
    wmctrl \
    x11-utils \
    x11vnc \
    xdotool \
    xvfb \
  && rm -rf /var/lib/apt/lists/*

COPY docker/desktop-realism/bin/ /usr/local/bin/
COPY docs/fixtures/desktop-realism/canary-manifest.json /opt/soma/desktop-realism/canary-manifest.json

RUN chmod 0755 \
    /usr/local/bin/canary-gtk-app.py \
    /usr/local/bin/canary-qt-app.py \
    /usr/local/bin/desktop-realism-entrypoint \
    /usr/local/bin/desktop-realism-healthcheck \
    /usr/local/bin/desktop-realism-isolation-check \
    /usr/local/bin/desktop-realism-session

EXPOSE 6080

HEALTHCHECK --interval=5s --timeout=3s --start-period=20s --retries=12 \
  CMD ["/usr/local/bin/desktop-realism-healthcheck"]

ENTRYPOINT ["/usr/local/bin/desktop-realism-entrypoint"]
