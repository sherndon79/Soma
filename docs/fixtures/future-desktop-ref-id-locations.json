{
  "status": "future_fixture_not_current_schema",
  "purpose": "Document candidate locations for future opaque desktop_ref_id exposure without enabling them in the current runtime.",
  "allowed_future_locations": [
    "tree.applications[].root_object.desktop_ref_id",
