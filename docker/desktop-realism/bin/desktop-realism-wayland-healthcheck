#!/usr/bin/env bash
set -euo pipefail

manifest="${CANARY_MANIFEST:-/opt/soma/desktop-realism/canary-manifest.json}"
display="${DISPLAY:-:99}"
novnc_port="${NOVNC_PORT:-6080}"
session_bus_file="/tmp/soma-session-bus-address"
runtime_dir="${XDG_RUNTIME_DIR:-/tmp/soma-wayland-runtime}"
wayland_display="${WAYLAND_DISPLAY:-soma-wayland-0}"

xdpyinfo -display "$display" >/dev/null
pgrep -x gnome-shell >/dev/null
pgrep -f 'canary-gtk-app.py' >/dev/null
pgrep -f 'canary-qt-app.py' >/dev/null
pgrep -f 'firefox' >/dev/null
pgrep -f '/opt/microsoft/msedge/msedge|microsoft-edge' >/dev/null
pgrep -x x11vnc >/dev/null
pgrep -f 'websockify' >/dev/null
test -s "$manifest"
test -S "$runtime_dir/$wayland_display"

python3 - "$manifest" <<'PY'
import json
import sys
manifest = json.load(open(sys.argv[1], encoding="utf-8"))
tokens = [entry["token"] for entry in manifest["canaries"]]
assert len(tokens) == len(set(tokens))
for entry in manifest["canaries"]:
    assert entry["expected_present_in_steward_view"] is True
    assert entry["expected_absent_in_occupant_output"] is True
    if entry["channel"] == "process":
        assert entry["placement"].lower() == "gtk raw process name"
    else:
        assert "process" not in entry["placement"].lower()
    assert "binary" not in entry["placement"].lower()
    assert "dbus" not in entry["placement"].lower()
    assert "path" not in entry["placement"].lower()
PY

curl -fsS "http://127.0.0.1:${novnc_port}/vnc.html" >/dev/null

if [ ! -s "$session_bus_file" ]; then
  echo "FAIL: private session DBus address file is missing" >&2
  exit 1
fi
export DBUS_SESSION_BUS_ADDRESS="$(cat "$session_bus_file")"

gdbus call \
  --session \
  --dest org.a11y.Bus \
  --object-path /org/a11y/bus \
  --method org.a11y.Bus.GetAddress >/dev/null

gdbus introspect \
  --session \
  --dest org.freedesktop.portal.Desktop \
  --object-path /org/freedesktop/portal/desktop \
  >/tmp/soma-wayland-portal-introspect.log
grep -q 'org.freedesktop.portal' /tmp/soma-wayland-portal-introspect.log
pgrep -f 'xdg-desktop-portal' >/dev/null
pgrep -f 'xdg-desktop-portal-gnome' >/dev/null

/usr/local/bin/desktop-realism-atspi-token-probe.py \
  SOMA-CANARY-TITLE-GTK-7f3c-DO-NOT-LEAK \
  SOMA-CANARY-TITLE-QT-61ad-DO-NOT-LEAK \
  SOMA-CANARY-GNOME-TEXT-2c91-DO-NOT-LEAK \
  SOMA-CANARY-GNOME-FILES-4a77-DO-NOT-LEAK \
  SOMA-CANARY-GNOME-TERM-f293-DO-NOT-LEAK \
  SOMA-CANARY-FIREFOX-TITLE-9e4b-DO-NOT-LEAK \
  SOMA-CANARY-EDGE-TITLE-c8d6-DO-NOT-LEAK \
  >/dev/null

/usr/local/bin/desktop-realism-wayland-isolation-check >/dev/null
