# Soma service
SOMA_PORT=8765
SOMA_LLM_URL=http://127.0.0.1:8000
SOMA_LLM_MODEL=ciocan/gemma-4-E4B-it-W4A16
# Sensorium stays off unless explicitly enabled by the operator.
SOMA_SENSORIUM_ENABLED=0
# SOMA_SENSOR_BROKER=/home/sherndon/project-repos/Soma/target/debug/soma-sensor-broker

# Local vLLM compose
LLM_PORT=8000
LLM_MODEL=ciocan/gemma-4-E4B-it-W4A16
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEMORY_UTILIZATION=0.50
VLLM_MAX_CONCURRENCY=4
VLLM_TOOL_CALL_PARSER=gemma4
LLM_CUDA_VISIBLE_DEVICES=0
