        {
          "service": ":1.42",
          "root_object": {
            "path": "/org/a11y/atspi/accessible/root",
            "desktop_ref_id": "desktop-ref-root",
            "children_sample": [
              {
                "service": ":1.42",
                "path": "/child",
                "desktop_ref_id": "desktop-ref-child"
              }
